# {{ ansible_managed }}
# Core isolation
#
# The 'isolated_cores=' variable below controls which cores should be
# isolated. Reserve at least 1 core per socket for housekeeping and
# isolate the rest. Keep only one isolated_cores= line.
#
# Examples:
#
# isolated_cores=12-15,28-31,32-47,60-63
# isolated_cores=32-47
isolated_cores={{ amd_low_latency_isolated_cores }}

# To disable the kernel load balancing in certain isolated CPUs:
#
# Examples:
#
# no_balance_cores=12-15,28-31,33-47,60-63
# no_balance_cores=32-47
{% if amd_low_latency_no_balance_cores | default('') | length > 0 %}
no_balance_cores={{ amd_low_latency_no_balance_cores }}
{% else %}
# no_balance_cores=
{% endif %}
