#!/usr/bin/env bash
set -euo pipefail

# Housekeeping CPUs where kernel helper threads should run.
HK_CPUS="{{ hk_cpus | default('0,1,12,13') }}"

echo "Pinning kernel housekeeping threads to CPUs ${HK_CPUS}"

pin_pid() {
  local pid="$1"
  local comm
  comm=$(ps -p "${pid}" -o comm= 2>/dev/null || true)
  if [[ -z "${comm}" ]]; then
    return
  fi
  if taskset -cp "${HK_CPUS}" "${pid}" >/dev/null; then
    printf '  %-7s %s\n' "${pid}" "${comm}"
  fi
}

# ksoftirqd, rcu*, kworker threads
ps -eo pid,comm | awk '
  $2 ~ /^(ksoftirqd|kworker|rcu)/ { print $1 }
' | while read -r pid; do
  pin_pid "${pid}"
done

echo "Done."

