# Example inventory. Copy to inventory.ini (or pass -i) and fill in your hosts.
#
# Group variables live in group_vars/:
#   group_vars/all.yml    - defaults for every host (CPU layout, role flags)
#   group_vars/local.yml  - [local] group: no bootloader changes
#   group_vars/remote.yml - [remote] group: full tuned profile

[local]
localhost ansible_connection=local

[remote]
# host1 ansible_host=192.168.1.10 ansible_user=ec2-user
# host2 ansible_host=192.168.1.11 ansible_user=ec2-user
